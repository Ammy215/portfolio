---
import { Font, getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import { profile, links } from '../data/profile';
import photo from '../assets/photo-cropped.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const photoOptimized = await getImage({ src: photo, width: 480 });
const photoUrl = new URL(photoOptimized.src, Astro.site);

// Real profile facts only, sourced from src/data/profile.ts — same rule as everywhere else.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  email: profile.email,
  jobTitle: profile.tagline,
  url: String(Astro.site),
  image: String(photoUrl),
  sameAs: links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#38bdf8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-departure" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
