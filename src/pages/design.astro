---
// Internal style tile for design review. Not linked, not in the sitemap, noindex. Removed at launch.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { projectHref, projectHrefLabel } from '../data/projects';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout title="Style tile" description="Internal design review page." noindex>
  <Hero />

  <!-- ============ WORK: colour-block bento ============ -->
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <header class="section-head">
      <h2 id="work-title">Shipped<br /> work</h2>
      <p class="support">
        Seven platforms. Each one has a real story: what it does, what broke in testing, and how it got fixed.
      </p>
      <p class="section-head__count data" aria-hidden="true">07</p>
    </header>

    <div class="bento">
      <article class="block block--cyan bento__flag">
        <div class="block__top">
          <span class="tag">correlation</span>
          <span class="tag tag--live">live</span>
        </div>
        <h3 class="block__title block__title--xl"><a class="block__link" href={projectHref('mini-siem')} {...ext}>Mini SIEM</a></h3>
        <p class="block__go data">{projectHrefLabel('mini-siem') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">
          A SIEM built from scratch. Ingests logs in 11 auto-detected formats, runs 15 detection rules tagged with MITRE ATT&amp;CK IDs, and correlates one attacker's alerts into a single incident.
        </p>
        <dl class="evidence">
          <div><dt>27</dt><dd>build phases, grown from a 13-phase plan</dd></div>
          <div><dt>600+</dt><dd>backend tests, CI on an ephemeral database</dd></div>
          <div><dt>3 of 4</dt><dd>URL-encoded attacks were missed until the rules decoded input. Found and fixed.</dd></div>
        </dl>
        <p class="block__stack data">FastAPI / PostgreSQL / React 18 / own JWT + RBAC</p>
      </article>

      <article class="block block--ink bento__wide">
        <div class="block__top">
          <span class="tag">network traffic</span>
          <span class="tag tag--live">live</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('netsentinel')} {...ext}>NetSentinel</a></h3>
        <p class="block__go data">{projectHrefLabel('netsentinel') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede support">
          Upload a PCAP, get scored flows back. Isolation Forest and One-Class SVM on real captured traffic, with RAG-grounded AI explaining each anomaly.
        </p>
      </article>

      <article class="block block--amber">
        <div class="block__top">
          <span class="tag">deception</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('honeyshield')} {...ext}>HoneyShield</a></h3>
        <p class="block__go data">{projectHrefLabel('honeyshield') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">Multi-protocol honeypot on raw asyncio sockets. Spots coordinated campaigns by ASN and time window.</p>
        <span class="tag tag--partial tag--wrap">http live; ssh, ftp, telnet built but not deployed</span>
      </article>

      <article class="block block--wip">
        <div class="block__top">
          <span class="tag">logs</span>
          <span class="tag tag--progress">in progress</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('intelligent-log-analyzer')} {...ext}>Log Analyzer</a></h3>
        <p class="block__go data">{projectHrefLabel('intelligent-log-analyzer') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">A 12-phase enterprise rebuild. Final QA and deploy still to come.</p>
      </article>

      <article class="block block--mint">
        <div class="block__top">
          <span class="tag">web and urls</span>
          <span class="tag tag--live">live</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('phishguard-ai')} {...ext}>phishguard&#8209;ai</a></h3>
        <p class="block__go data">{projectHrefLabel('phishguard-ai') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">Random Forest plus a 16-rule heuristic engine, shipped with a working Chrome extension.</p>
      </article>

      <article class="block">
        <div class="block__top">
          <span class="tag tag--ghost">files</span>
          <span class="tag tag--live">live</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('fileshield')} {...ext}>FileShield</a></h3>
        <p class="block__go data">{projectHrefLabel('fileshield') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">Hashing, entropy and YARA matching. My first shipped project, and my first real production outage.</p>
      </article>

      <article class="block block--pale bento__wide">
        <div class="block__top">
          <span class="tag">threat intel</span>
          <span class="tag tag--live">live, private repo</span>
        </div>
        <h3 class="block__title"><a class="block__link" href={projectHref('threathunter')} {...ext}>ThreatHunter</a></h3>
        <p class="block__go data">{projectHrefLabel('threathunter') === 'Live site' ? 'opens the live site' : 'opens the code on GitHub'}</p>
        <p class="block__lede">
          IOC search across IP, domain, hash and URL, fanned out to AbuseIPDB, OTX, IPInfo, VirusTotal and NIST NVD. 89 automated tests and an adversarial testing pass: 8 findings, each fixed and retested.
        </p>
      </article>
    </div>
  </section>

  <About />

  <!-- ============ QUOTE: full-bleed accent band ============ -->
  <section class="quote-band grain" aria-label="Quote">
    <blockquote class="wrap">
      <p>
        <span class="quote__soft">I didn't sign up for the parts that were easy.</span>
        I signed up for the whole thing.
      </p>
    </blockquote>
  </section>

  <Contact />

  <!-- Review-only: switch the world colour -->
  <div class="world-switch" role="group" aria-label="World colour">
    <button type="button" data-world-btn="cyan" aria-pressed="true">Cyan world</button>
    <button type="button" data-world-btn="amber" aria-pressed="false">Amber world</button>
  </div>
</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-world-btn]');
  const setWorld = (w: string) => {
    if (w === 'cyan') delete document.documentElement.dataset.world;
    else document.documentElement.dataset.world = w;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.worldBtn === w)));
    document.dispatchEvent(new Event('worldchange'));
  };
  btns.forEach((b) => b.addEventListener('click', () => setWorld(b.dataset.worldBtn!)));
  const fromUrl = new URLSearchParams(location.search).get('world');
  if (fromUrl === 'amber') setWorld('amber');
</script>

<style>
  /* ---------- section header: huge left, small support right ---------- */
  .section-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    margin-bottom: var(--space-l);
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head .support {
    margin: 0 0 0.6rem;
  }
  .section-head__count {
    font-size: var(--step-2);
    margin: 0 0 0.4rem;
  }

  /* ---------- work ---------- */
  .work {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-s);
  }
  .bento__flag {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento__wide {
    grid-column: span 2;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    min-height: 15rem;
    container-type: inline-size;
  }
  .block--pale {
    background: var(--world-pale);
  }
  .block__go {
    margin: -0.2rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .block--ink .block__go {
    color: rgb(255 255 255 / 0.75);
  }
  .tag--wrap {
    white-space: normal;
    border-radius: 12px;
    line-height: 1.25;
    align-self: flex-start;
  }
  .block__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }
  .block__title {
    margin: auto 0 0;
    /* sized to the card, so long names like PHISHGUARD-AI stay on one line */
    font-size: clamp(1.7rem, 12cqi, 3rem);
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    line-height: 0.9;
  }
  .block__title--xl {
    font-size: clamp(3.2rem, 16cqi, 6.5rem);
    line-height: 0.84;
  }
  .block__lede {
    margin: 0;
    font-weight: 450;
    line-height: 1.45;
    max-width: 44ch;
  }
  .bento__flag .block__lede {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
  }
  .block__stack {
    margin: 0;
    font-size: var(--step--1);
  }
  .block--ink .tag {
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
  }
  .block--ink .tag::before {
    box-shadow: none;
  }
  .block--ink .block__lede {
    color: rgb(255 255 255 / 0.85);
  }
  /* in progress: construction stripes along the top, honest about the status */
  .block--wip {
    background:
      repeating-linear-gradient(135deg, var(--amber) 0 14px, var(--ink) 14px 28px) top / 100% 10px no-repeat,
      var(--white);
    padding-top: calc(clamp(1.25rem, 1rem + 1vw, 2rem) + 10px);
  }

  .evidence {
    margin: var(--space-xs) 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
  }
  .evidence div {
    background: rgb(255 255 255 / 0.6);
    border-radius: var(--radius-inset);
    padding: 0.9rem 1rem;
  }
  .evidence dt {
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.9rem);
    line-height: 0.9;
    margin-bottom: 0.35rem;
  }
  .evidence dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.35;
  }

  /* ---------- quote band ---------- */
  .quote-band {
    position: relative;
    isolation: isolate;
    background: var(--accent);
    padding-block: var(--space-3xl);
  }
  .quote-band blockquote {
    margin-block: 0;
  }
  .quote-band p {
    max-width: none;
    margin: 0;
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    text-transform: uppercase;
    font-size: clamp(2.6rem, 1.2rem + 6vw, 7.2rem);
    line-height: 0.88;
    text-wrap: balance;
  }
  .quote__soft {
    font-weight: 500;
    display: block;
  }

  /* ---------- world switch (review only) ---------- */
  .world-switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: var(--radius-chip);
    background: var(--ink);
    box-shadow: var(--shadow-lifted);
  }
  .world-switch button {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    border: 0;
    border-radius: var(--radius-chip);
    padding: 0.45rem 0.9rem;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .world-switch button[aria-pressed='true'] {
    background: var(--white);
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .section-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .section-head .support {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--space-s);
    }
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .bento__flag,
    .bento__wide {
      grid-column: auto;
      grid-row: auto;
    }
    .evidence {
      grid-template-columns: minmax(0, 1fr);
    }
    .block {
      min-height: 0;
    }
    .block__title {
      margin-top: var(--space-m);
    }
  }
</style>
