---
import { profile, links } from '../data/profile';

const external = (href: string) => href.startsWith('http');
---

<section id="contact" class="contact grain" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <div class="contact__head">
      <p class="tag contact__tag">open to work</p>
      <h2 id="contact-title">Let's<br /> talk</h2>
    </div>
    <div class="contact__body">
      <p class="contact__lede">
        I'm looking for an entry-level role in security engineering, SOC / detection, or networking. If you're hiring, or want a walkthrough of any of the code, email me or reach out on LinkedIn.
      </p>
      <div class="contact__mailrow">
        <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="btn contact__copy" type="button" data-copy={profile.email} hidden>Copy email</button>
        <span class="contact__copied data" aria-live="polite"></span>
      </div>
      <ul class="contact__links">
        {profile.resume && (
          <li>
            <a class="btn btn--mint" href={profile.resume} download>Download resume (PDF)</a>
          </li>
        )}
        {links.filter((l) => l.label !== 'Email').map((l) => (
          <li>
            <a class="btn" href={l.href} {...(external(l.href) ? { rel: 'noopener noreferrer', target: '_blank' } : {})}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('.contact__copied');
  if (btn && status && navigator.clipboard) {
    btn.hidden = false;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
        status.textContent = 'Email address copied to clipboard';
      } catch {
        status.textContent = "Couldn't copy. Select the address instead.";
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = 'Copy email';
        status.textContent = '';
      }, 2200);
    });
  }
</script>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    background: var(--ink);
    color: var(--white);
    padding-block: var(--space-2xl);
  }
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .contact__tag {
    --sq: var(--mint);
    margin-bottom: var(--space-m);
  }
  .contact h2 {
    margin: 0;
    font-size: clamp(3.6rem, 1.6rem + 7vw, 9rem);
    line-height: 0.84;
  }
  .contact__lede {
    color: rgb(255 255 255 / 0.85);
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 40ch;
  }
  .contact__mailrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin: var(--space-s) 0 var(--space-l);
  }
  .contact__copy {
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    font: inherit;
    font-weight: 650;
    font-size: var(--step--1);
    border: 0;
    cursor: pointer;
  }
  .contact__copy[hidden] {
    display: none;
  }
  .contact__copied:empty {
    display: none;
  }
  .contact__copied {
    width: 100%;
    font-size: var(--step--1);
    color: var(--mint);
  }
  .btn--mint {
    background: var(--mint);
    color: var(--ink);
  }
  .contact__email {
    display: inline-block;
    font-weight: 800;
    font-variation-settings: var(--wdth-heading);
    font-size: clamp(1.5rem, 0.9rem + 2.4vw, 2.8rem);
    line-height: 1.05;
    color: var(--mint);
    text-decoration-color: var(--mint);
    overflow-wrap: anywhere;
  }
  .contact__email:hover {
    color: var(--white);
    text-decoration-color: var(--white);
  }
  .contact__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .contact :focus-visible {
    outline-color: var(--white);
  }

  @media (max-width: 52rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
