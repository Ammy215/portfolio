---
import { layers, nodes, hubs } from '../data/graph';
import { projectHref } from '../data/projects';
import { profile } from '../data/profile';

const ext = { target: '_blank', rel: 'noopener noreferrer' };

interface Props {
  variant?: 'illustrated' | 'engineered';
}
const { variant = 'illustrated' } = Astro.props;

const byLayer = layers.map((l) => ({ ...l, node: nodes.find((n) => n.layer === l.id)! }));
---

<section class="hero grain" aria-labelledby="hero-title">
  <!-- 3D diorama fills the section; everything readable is HTML on top of it -->
  <div class="hero__stage" data-hero-stage data-variant={variant}>
    <canvas class="hero__canvas" aria-hidden="true"></canvas>
    <div class="hero__labels" data-hero-labels>
      {nodes.map((n) => (
        <a class="sign" href={projectHref(n.slug)} {...ext} data-slug={n.slug} data-zone={n.zone}>
          <span class:list={['sign__sq', n.inProgress ? 'sign__sq--progress' : `sign__sq--${n.zone}`]}></span>
          {n.name}
        </a>
      ))}
    </div>
  </div>

  <header class="topbar wrap">
    <a class="topbar__mark" href="/">Ammar Badlawala</a>
    <nav aria-label="Main">
      <ul class="topbar__nav">
        <li><a href="#work">Work</a></li>
        <li><a href="/roadmap">Roadmap</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <div class="hero__copy wrap">
    <p class="tag hero__tag">cybersecurity × networking × ai</p>
    <h1 id="hero-title">
      <span class="visually-hidden">Ammar Badlawala: </span>Build it.<br /> Break it.<br /> <span class="hero__hl">Fix it.</span>
    </h1>
    <div class="hero__aside">
      <p class="hero__lede">
        I'm <strong>Ammar Badlawala</strong>, a B.Sc. IT graduate working toward security engineering by shipping real security platforms, then attacking them to learn exactly how they fail.
      </p>
      <p class="hero__meta">{profile.openTo}</p>
      <p class="hero__now data">
        <span class="hero__now-label">now building</span>
        <a href={profile.nowBuilding.href} {...ext}>{profile.nowBuilding.text}</a>
      </p>
      <div class="hero__actions">
        <a class="btn btn--ink" href="#work">See the work</a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>

  <p class="hero__hint data" aria-hidden="true">hover a station to explore</p>

  <!-- Same map as text: shown when WebGL isn't available, always available to screen readers. -->
  <div class="hero__fallback wrap" data-hero-fallback>
    <p class="hero__fallback-title">Seven projects, placed where each one sits in a defense:</p>
    <ol class="layer-list">
      {byLayer.map((l) => (
        <li>
          <span class="data">{l.label}</span>
          <a href={projectHref(l.node.slug)} {...ext}>{l.node.name}</a>
        </li>
      ))}
    </ol>
    <ul class="hub-list">
      {hubs.map((h) => (
        <li>
          <span class="data">{h.label}</span>: shared by {h.projects.map((s) => nodes.find((n) => n.slug === s)!.name).join(', ')}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const fallback = document.querySelector<HTMLElement>('[data-hero-fallback]');
  const canvas = stage?.querySelector('canvas');
  const labels = stage?.querySelector<HTMLElement>('[data-hero-labels]');

  const hasWebGL2 = (() => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  })();

  if (stage && fallback && canvas && labels && hasWebGL2) {
    stage.classList.add('is-live');
    fallback.classList.add('visually-hidden');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // ?scene=engineered|illustrated overrides the default, for design comparison
    const fromUrl = new URLSearchParams(location.search).get('scene');
    const variant = fromUrl === 'engineered' || fromUrl === 'illustrated' ? fromUrl : (stage.dataset.variant as 'illustrated' | 'engineered');
    const boot = () =>
      import('../scripts/hero/scene').then(({ initHero }) => initHero({ canvas, labels, reducedMotion, variant }));
    // keep Three.js off the critical path: text paints first
    if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1200 });
    else setTimeout(boot, 200);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: clamp(38rem, 100svh, 64rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* one hue floods the whole scene: deeper at the top, paling toward the ground line */
    background:
      radial-gradient(70% 55% at 72% 38%, rgb(255 255 255 / 0.28), transparent 70%),
      linear-gradient(172deg, var(--world-deep) 0%, var(--world) 45%, var(--world-pale) 100%);
    color: var(--ink);
  }
  .hero.grain::after {
    z-index: 0;
  }

  /* ---- stage ---- */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
  }
  .hero__stage.is-live {
    display: block;
  }
  .hero__canvas {
    width: 100%;
    height: 100%;
  }
  .hero__labels {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }
  .sign {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem 0.42rem 0.6rem;
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-weight: 800;
    font-variation-settings: var(--wdth-heading);
    font-size: 0.95rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--shadow-raised);
    pointer-events: auto;
    transition: background-color 150ms, color 150ms, scale 150ms;
  }
  /* post of the signpost */
  .sign::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 3px;
    height: 0.9rem;
    translate: -50% 0;
    background: var(--white);
  }
  .sign__sq {
    width: 0.6rem;
    height: 0.6rem;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .sign__sq--outside { background: var(--cyan); }
  .sign__sq--inside { background: var(--mint); }
  .sign__sq--core { background: var(--mint); }
  .sign__sq--progress { background: var(--amber); }
  .sign:hover,
  .sign:focus-visible,
  .sign.is-active {
    background: var(--ink);
    color: var(--white);
    scale: 1.06;
  }
  .sign:hover::after,
  .sign:focus-visible::after,
  .sign.is-active::after {
    background: var(--ink);
  }

  /* ---- top bar ---- */
  .topbar {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-m);
  }
  .topbar__mark {
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .topbar__nav {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    border-radius: var(--radius-chip);
    background: rgb(255 255 255 / 0.55);
    backdrop-filter: blur(8px);
  }
  .topbar__nav a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-chip);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .topbar__nav a:hover {
    background: var(--white);
  }

  /* ---- copy: bottom-left, big and tight, with small support beside it ---- */
  .hero__copy {
    position: relative;
    z-index: 3;
    grid-row: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: clamp(2rem, 6vh, 4.5rem);
    pointer-events: none;
  }
  .hero__copy > * {
    pointer-events: auto;
  }
  .hero__tag {
    margin-bottom: var(--space-m);
  }
  .hero__copy h1 {
    margin: 0 0 var(--space-m);
    font-size: clamp(3.4rem, 1rem + 5.6vw, 7.4rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
  }
  .hero__hl {
    display: inline-block;
    background: var(--white);
    padding: 0.04em 0.14em 0;
    margin-left: -0.14em;
    border-radius: 0.08em;
    box-shadow: var(--shadow-raised);
  }
  .hero__lede strong {
    font-weight: 700;
  }
  .hero__aside {
    max-width: 30rem;
  }
  .hero__lede {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.005em;
    margin-bottom: var(--space-s);
  }
  .hero__meta {
    font-size: var(--step--1);
    font-weight: 450;
    color: var(--ink-2);
  }
  .hero__now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    font-size: var(--step--1);
    margin: 0;
  }
  .hero__now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
  }
  .hero__now-label::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--amber);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .hero__now a {
    text-decoration-thickness: 2px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  .hero__hint {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.25rem, 3vh, 2rem);
    z-index: 3;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
    opacity: 0.8;
  }

  /* ---- fallback (no WebGL) ---- */
  .hero__fallback {
    position: relative;
    z-index: 3;
    grid-row: 2;
    align-self: center;
    padding: var(--space-l);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.6);
  }
  .hero__fallback-title {
    font-weight: 700;
  }
  .layer-list {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .layer-list li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-s);
  }
  .hub-list {
    padding-left: 1.1rem;
    font-size: var(--step--1);
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-rows: auto minmax(52svh, 1fr) auto;
    }
    .hero__copy {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-m);
    }
    .hero__hint {
      display: none;
    }
    .topbar__nav a {
      padding: 0.45rem 0.6rem;
    }
  }
  @media (max-width: 36rem) {
    .topbar__mark {
      white-space: nowrap;
      font-size: 1.15rem;
    }
    .topbar__nav a {
      padding: 0.4rem 0.5rem;
      font-size: 0.85rem;
    }
  }
  @media (max-width: 26rem) {
    .topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }
</style>
