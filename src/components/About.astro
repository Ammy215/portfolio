---
import { profile, certifications } from '../data/profile';
import { projectHref } from '../data/projects';
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <h2 id="about-title" class="about__title">About me</h2>

  <div class="about__grid">
    <div class="about__text">
      <p class="about__lead">
        B.Sc. Information Technology graduate building toward a career in security engineering — not through certifications alone, but by shipping real, working security platforms.
      </p>
      <p>
        My flagship project, a <a href={projectHref('mini-siem')} target="_blank" rel="noopener noreferrer">SIEM built from scratch</a>, runs detection rules tagged to MITRE ATT&amp;CK and has survived its own adversarial testing: I found and fixed a real detection gap where URL-encoded payloads slipped past signature rules, and after deployment, caught and patched a genuine IP-spoofing vulnerability in my own rate-limiting logic. Alongside it, I've built a multi-protocol honeypot that's caught live attack traffic in production, a machine-learning network anomaly detector trained on real packet captures, and a phishing-detection platform combining a trained model with live threat-intelligence feeds.
      </p>
      <p>
        My technical foundation spans Python, FastAPI, PostgreSQL, and React on the build side, and Nmap, Wireshark, and threat-intelligence APIs on the security side — backed by hands-on certifications in networking, endpoint security, and applied AI/ML from Cisco and Coursera. I'm currently going deeper into AI-assisted detection and threat analysis, the direction I think security engineering is heading next.
      </p>
      <p>
        I'm looking for an entry-level role in security engineering, SOC/detection, or networking, where I can keep building the way I already do: hands-on, security-first, and willing to break my own systems to learn exactly how they fail.
      </p>
    </div>

    <aside class="about__side" aria-label="Quick facts">
      <div class="stickers">
        <figure class="sticker sticker--photo">
          <div class="sticker__ph">Photo<br />coming</div>
          <figcaption class="data">the real person</figcaption>
        </figure>
        <figure class="sticker sticker--pixel">
          <div class="sticker__ph sticker__ph--pixel">Pixel<br />character</div>
          <figcaption class="data">the build identity</figcaption>
        </figure>
      </div>

      <dl class="facts">
        <div><dt>Degree</dt><dd>B.Sc. Information Technology</dd></div>
        <div><dt>CGPA</dt><dd>9.84 (A+)</dd></div>
        <div><dt>Looking for</dt><dd>{profile.lookingFor}</dd></div>
        <div><dt>Going deeper into</dt><dd>AI-assisted detection and threat analysis</dd></div>
      </dl>
    </aside>
  </div>

  <div class="certs" aria-labelledby="certs-title">
    <h3 id="certs-title" class="certs__title">Certifications</h3>
    {certifications.map((group) => (
      <div class="certs__group">
        <p class="certs__issuer">{group.issuer}</p>
        <ul class="certs__list">
          {group.items.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-2xl);
  }
  .about__title {
    margin-bottom: var(--space-l);
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .about__text p {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--ink-2);
  }
  .about__text .about__lead {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: var(--space-l);
  }

  /* ---- side: stickers + facts ---- */
  .stickers {
    position: relative;
    /* height follows width so the rotated stickers never spill onto the facts card */
    aspect-ratio: 1 / 0.98;
    margin-bottom: var(--space-l);
  }
  .sticker {
    position: absolute;
    margin: 0;
    padding: 0.6rem 0.6rem 0.8rem;
    background: var(--white);
    border-radius: 18px;
    box-shadow: var(--shadow-lifted);
  }
  .sticker figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    text-align: center;
  }
  .sticker--photo {
    width: 54%;
    left: 4%;
    top: 0;
    rotate: -4deg;
  }
  .sticker--pixel {
    width: 46%;
    right: 2%;
    bottom: 0;
    rotate: 5deg;
  }
  .sticker__ph {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--paper);
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 0.9;
    color: var(--ink-2);
  }
  .sticker__ph--pixel {
    aspect-ratio: 1;
    background:
      conic-gradient(from 90deg at 1px 1px, transparent 90deg, rgb(11 22 32 / 0.12) 0) 0 0 / 14px 14px,
      var(--mint);
    color: var(--ink);
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 2px;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }
  .facts div {
    background: var(--white);
    padding: 0.9rem 1.2rem;
  }
  .facts dt {
    font-family: var(--font-data);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.3;
  }

  /* ---- certifications ---- */
  .certs {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-l);
    row-gap: var(--space-m);
    align-items: baseline;
  }
  .certs__title {
    grid-column: 1 / -1;
    font-size: var(--step-2);
    margin: 0;
  }
  .certs__group {
    display: contents;
  }
  .certs__issuer {
    margin: 0;
    font-weight: 900;
    font-variation-settings: var(--wdth-display);
    text-transform: uppercase;
    font-size: var(--step-1);
    min-width: 6.5rem;
  }
  .certs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .certs__list li {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-chip);
    background: var(--white);
    font-weight: 500;
    font-size: var(--step--1);
    box-shadow: 0 1px 2px rgb(11 22 32 / 0.08);
  }

  @media (max-width: 60rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__side {
      max-width: 28rem;
    }
    .certs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
